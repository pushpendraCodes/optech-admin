# Admin panel (Vite) — copy to `.env` or `.env.local` in this folder.
# Restart `pnpm run dev` after changing values.

# Backend API base URL (used by RTK Query)
# Dev with Vite proxy:     /api/v1
# Direct to backend:       http://localhost:4000/api/v1
# Production:              https://your-api-domain.com/api/v1
VITE_API_URL=/api/v1

# Dev only — Vite proxies /api/* to this backend (see vite.config.ts)
VITE_API_PROXY_TARGET=http://localhost:4000

